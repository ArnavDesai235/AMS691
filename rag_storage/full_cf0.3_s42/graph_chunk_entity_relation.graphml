    <node id="Operational Impact">
      <data key="d0">Operational Impact</data>
      <data key="d1">concept</data>
      <data key="d2">The effect of project-related events or decisions on the day-to-day functioning of the organization, which is minimized through early risk escalation and intervention.</data>
