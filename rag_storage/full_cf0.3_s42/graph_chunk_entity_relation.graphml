    </node>
    <node id="Team Stability">
      <data key="d0">Team Stability</data>
      <data key="d1">concept</data>
      <data key="d2">Team Stability refers to the ongoing efforts by the Human Resources Team to ensure a consistent and effective workforce through training and support initiatives.</data>
      <data key="d3">d-public-085-chunk-000</data>
      <data key="d4">d-public-085</data>
      <data key="d5">1793663616</data>
      <data key="d6" />
    </node>
    <node id="Drugooan Platform Group">
      <data key="d0">Drugooan Platform Group</data>
      <data key="d1">organization</data>
      <data key="d2">A team focused on developing and maintaining platforms that support customer-facing services. It is based at the Pozoine Campus and works closely with product, engineering, and support teams.&lt;SEP&gt;A group within Zastama Industries working on platform updates and interoperability with engineering initiatives.</data>
      <data key="d3">d-public-086-chunk-000&lt;SEP&gt;d-exec-015-chunk-000</data>
      <data key="d4">d-public-086&lt;SEP&gt;d-exec-015</data>
