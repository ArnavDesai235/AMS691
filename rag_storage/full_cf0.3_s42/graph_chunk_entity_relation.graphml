      <data key="d0">Stakeholder</data>
      <data key="d1">person</data>
      <data key="d2">An individual or group with an interest in the progress and outcomes of Project Tinpia. Stakeholders are kept informed through transparency and regular updates.</data>
      <data key="d3">d-public-013-chunk-000</data>
      <data key="d4">d-public-013</data>
