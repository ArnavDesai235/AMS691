    <node id="Workforce Scalability">
      <data key="d0">Workforce Scalability</data>
      <data key="d1">concept</data>
      <data key="d2">The ability of a project team to expand or contract in size to meet changing demands, such as the evaluation being conducted for Project Laboel.</data>
