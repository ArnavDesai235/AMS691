    <node id="Internal Briefing">
      <data key="d0">Internal Briefing</data>
      <data key="d1">event</data>
      <data key="d2">A regular meeting or update session held within the organization, such as the weekly internal briefings for Project Laboel.</data>
      <data key="d3">d-public-031-chunk-000</data>
      <data key="d4">d-public-031</data>
