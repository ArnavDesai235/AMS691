    <node id="Company-Wide Coordination">
      <data key="d0">Company-Wide Coordination</data>
      <data key="d1">concept</data>
      <data key="d2">Company-Wide Coordination refers to the effort to improve communication and alignment across Zastama Industries' key operational sites and projects.</data>
