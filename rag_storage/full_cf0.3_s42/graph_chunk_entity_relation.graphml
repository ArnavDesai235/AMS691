    <node id="Cross-Functional Workshops">
      <data key="d0">Cross-Functional Workshops</data>
      <data key="d1">event</data>
      <data key="d2">Cross-functional workshops have been initiated by Ragos Drosporel to ensure that operational teams understand the implications of the forecasting models and can translate them into actionable plans.</data>
      <data key="d3">d-team_b-017-chunk-000</data>
      <data key="d4">d-team_b-017</data>
