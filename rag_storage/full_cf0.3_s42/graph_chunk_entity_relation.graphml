    <node id="Operational Resilience">
      <data key="d0">Operational Resilience</data>
      <data key="d1">concept</data>
      <data key="d2">A strategic goal of Zastama Industries to reduce dependency on single vendors and enhance supply chain diversity.&lt;SEP&gt;A strategic initiative aimed at minimizing single points of failure and enhancing the robustness of internal systems and processes across all departments.</data>
      <data key="d3">d-public-011-chunk-000&lt;SEP&gt;d-exec-006-chunk-000</data>
      <data key="d4">d-public-011&lt;SEP&gt;d-exec-006</data>
