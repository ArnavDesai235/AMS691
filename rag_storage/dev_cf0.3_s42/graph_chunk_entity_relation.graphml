      <data key="d0">Restricted Planning Sync</data>
      <data key="d1">event</data>
      <data key="d2">A working session at Zastama Industries to align on field capacity, audit follow-up, and launch readiness for the Feltarel Relay.&lt;SEP&gt;An internal working session focused on platform dependencies, audit follow-up, and staffing review.</data>
      <data key="d3">d-team_a-000-chunk-000&lt;SEP&gt;d-team_a-004-chunk-000</data>
