    <node id="Departmental Lead">
      <data key="d0">Departmental Lead</data>
      <data key="d1">person</data>
      <data key="d2">A leadership position within a department at Zastama Industries, responsible for participating in coordination meetings and providing updates relevant to their team.&lt;SEP&gt;Departmental Leads are responsible for addressing employee questions or concerns about Hurpuman Partners or related activities. They are encouraged to provide guidance to employees.</data>
      <data key="d3">d-public-031-chunk-000&lt;SEP&gt;d-public-036-chunk-000</data>
