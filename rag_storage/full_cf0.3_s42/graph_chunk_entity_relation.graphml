    <node id="Quarterly Review">
      <data key="d0">Quarterly Review</data>
      <data key="d1">event</data>
      <data key="d2">A scheduled meeting or assessment conducted every three months, such as the quarterly review of the risk register by the project office.&lt;SEP&gt;A recurring review to be conducted by the engineering and procurement teams to assess Nerasan Labs' performance and component delivery timelines.</data>
      <data key="d3">d-public-031-chunk-000&lt;SEP&gt;d-public-118-chunk-000</data>
      <data key="d4">d-public-031&lt;SEP&gt;d-public-118</data>
      <data key="d5">1793692153</data>
